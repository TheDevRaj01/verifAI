# ==========================================
# VerifAI — AICTE Application Validation
# Firebase Configuration
# ==========================================
# If these variables are not configured, the application runs automatically
# in Local Simulation Mode using in-browser persistence (localStorage)
# and pre-seeded realistic AICTE demo records.
#
# To connect to your live Firebase project:
# 1. Go to https://console.firebase.google.com/
# 2. Create or select a project
# 3. Enable Authentication (Email/Password provider)
# 4. Enable Cloud Firestore
# 5. Copy your web app config values into a .env file:

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
