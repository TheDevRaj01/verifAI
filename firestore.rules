rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Security Helper Functions
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Admin role must be verified via server-signed custom claims or verified email from official registry
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email.lower() in [
          'admin@aicte.gov.in',
          'scrutiny@aicte-india.org',
          'director.approval@aicte.gov.in'
        ] ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().role == 'admin'
        )
      );
    }

    function getCollegeIdFromEmail() {
      return request.auth.token.email.lower() == 'principal@delhitechnical.edu.in' ? '1-10972341'
        : request.auth.token.email.lower() == 'director@mumbaipolytechnic.edu.in' ? '1-24891102'
        : request.auth.token.email.lower() == 'info@karnatakatech.ac.in' ? '1-38290145'
        : request.auth.token.email.lower() == 'registrar@bengalpharmacy.edu.in' ? '1-49012389'
        : request.auth.token.email.lower() == 'principal@tnengineering.edu.in' ? '1-51289033'
        : null;
    }

    // College user verified via server-signed custom claims, official institutional email, or admin-provisioned user profile
    function isCollegeUser() {
      return isAuthenticated() && (
        request.auth.token.role == 'college' ||
        getCollegeIdFromEmail() != null ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().role == 'college'
        )
      );
    }

    function getCollegeId() {
      return request.auth.token.collegeId != null
        ? request.auth.token.collegeId
        : (
            getCollegeIdFromEmail() != null
              ? getCollegeIdFromEmail()
              : (
                  exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    ? getUserData().collegeId
                    : null
                )
          );
    }

    function isApplicationEditable(appData) {
      // Applications in active evaluation states can be edited/supplemented by colleges
      // Only finalized (Approved or Rejected) applications are locked
      return !(appData.status in ['Approved', 'Rejected']);
    }

    // ==========================================
    // 1. User Profiles (/users)
    // Strictly admin-provisioned to prevent self-elevation
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Admins can write any user; users can initialize/update their own profile without self-elevation
      allow write: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.role != 'admin'
      );
    }

    // ==========================================
    // 2. Colleges Collection (/colleges)
    // Directory read of recognized AICTE institutions
    // ==========================================
    match /colleges/{collegeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 3. Applications Collection (/applications)
    // Application metadata (strictly without binary payloads)
    // ==========================================
    match /applications/{applicationId} {
      // AICTE Admins can inspect all applications
      // Colleges can only read applications that belong to their own College ID
      allow read: if isAdmin() || (
        isCollegeUser() && resource.data.collegeId == getCollegeId()
      );

      // Authenticated colleges can create new applications for their own institution
      allow create: if isAdmin() || (
        isCollegeUser() &&
        request.resource.data.collegeId == getCollegeId() &&
        !(request.resource.data.status in ['Approved', 'Rejected'])
      );

      // Colleges can update their own drafts & active dossiers; cannot self-approve or change collegeId
      allow update: if isAdmin() || (
        isCollegeUser() &&
        resource.data.collegeId == getCollegeId() &&
        request.resource.data.collegeId == resource.data.collegeId &&
        isApplicationEditable(resource.data) &&
        !(request.resource.data.status in ['Approved', 'Rejected'] && !(resource.data.status in ['Approved', 'Rejected']))
      );

      // Applications cannot be deleted by colleges; only Admins can purge
      allow delete: if isAdmin();

      // ==========================================
      // 4. File Blobs Subcollection (/applications/{appId}/fileBlobs/{fileId})
      // Dedicated subcollection storing document and evidence binary content
      // ==========================================
      match /fileBlobs/{fileId} {
        // Institutional isolation: only admin or owning college can read
        allow read: if isAdmin() || (
          isCollegeUser() && (
            (exists(/databases/$(database)/documents/applications/$(applicationId)) &&
             get(/databases/$(database)/documents/applications/$(applicationId)).data.collegeId == getCollegeId()) ||
            (resource != null && resource.data.collegeId == getCollegeId())
          )
        );

        // Upload allowed for owning college while application is in an active/editable state
        allow create, update: if isAdmin() || (
          isCollegeUser() &&
          (
            !exists(/databases/$(database)/documents/applications/$(applicationId)) ||
            (
              get(/databases/$(database)/documents/applications/$(applicationId)).data.collegeId == getCollegeId() &&
              isApplicationEditable(get(/databases/$(database)/documents/applications/$(applicationId)).data)
            )
          ) &&
          (
            request.resource.data.collegeId == getCollegeId() ||
            !('collegeId' in request.resource.data)
          ) &&
          request.resource.data.fileId is string &&
          request.resource.data.applicationId == applicationId &&
          request.resource.data.dataUrl is string &&
          request.resource.data.dataUrl.size() <= 750000
        );

        // Deletion allowed only for owning college while application is editable
        allow delete: if isAdmin() || (
          isCollegeUser() &&
          (
            !exists(/databases/$(database)/documents/applications/$(applicationId)) ||
            (
              get(/databases/$(database)/documents/applications/$(applicationId)).data.collegeId == getCollegeId() &&
              isApplicationEditable(get(/databases/$(database)/documents/applications/$(applicationId)).data)
            )
          )
        );
      }
    }

    // ==========================================
    // 5. Unique ID Requests (/idRequests)
    // Onboarding request queue for unauthenticated applicants
    // ==========================================
    match /idRequests/{requestId} {
      allow create: if request.resource.data.status == 'Pending' &&
                       request.resource.data.collegeName is string &&
                       request.resource.data.officialEmail is string;

      // Sensitive contact information must not be readable by arbitrary users
      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // 6. Document Checklist Requirements (/checklists)
    // ==========================================
    match /checklists/{requirementId} {
      // Authenticated users (both colleges and admins) can read statutory requirements
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}

