rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ==========================================
    // Security Helper Functions
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin') ||
        request.auth.token.email in ['admin@aicte.gov.in', 'scrutiny@aicte-india.org', 'director.approval@aicte.gov.in']
      );
    }

    function isCollegeUser() {
      return isAuthenticated() && (
        request.auth.token.role == 'college' ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && getUserData().role == 'college')
      );
    }

    function getCollegeId() {
      return request.auth.token.collegeId != null 
        ? request.auth.token.collegeId 
        : (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) ? getUserData().collegeId : null);
    }

    function isValidFileSize() {
      // Hard ceiling of 15 MB per uploaded document/photo
      return request.resource.size < 15 * 1024 * 1024;
    }

    function isValidMimeType() {
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('image/.*');
    }

    // ==========================================
    // 1. Application Scrutiny Documents & Evidence
    // Path structure:
    // applications/{applicationId}/documents/{docId}/v{version}/{fileName}
    // applications/{applicationId}/evidence/{evidenceId}/{fileName}
    // ==========================================
    match /applications/{applicationId}/{allPaths=**} {
      // AICTE Admins can inspect all uploaded documents; Colleges can only read their own documents
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (
          isCollegeUser() &&
          firestore.exists(/databases/(default)/documents/applications/$(applicationId)) &&
          firestore.get(/databases/(default)/documents/applications/$(applicationId)).data.collegeId == getCollegeId()
        )
      );

      // Only authorized Admins or the owning College can write/upload files
      allow write: if isAuthenticated() && isValidFileSize() && isValidMimeType() && (
        isAdmin() ||
        (
          isCollegeUser() &&
          firestore.exists(/databases/(default)/documents/applications/$(applicationId)) &&
          firestore.get(/databases/(default)/documents/applications/$(applicationId)).data.collegeId == getCollegeId()
        )
      );

      // Only Admins or owning college can delete uploaded files
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (
          isCollegeUser() &&
          firestore.exists(/databases/(default)/documents/applications/$(applicationId)) &&
          firestore.get(/databases/(default)/documents/applications/$(applicationId)).data.collegeId == getCollegeId()
        )
      );
    }
  }
}
